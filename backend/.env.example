DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sylus
SYLUS_OWNER_TOKEN=replace-with-a-long-random-secret
APP_ENV=development

# All provider credentials below are optional. The app only calls a provider if its key is set.
# Normal conversations: Gemini first, then Groq, Aion Labs RP, OpenRouter free, Mistral, Cloudflare, Cohere.
# Mature/romantic-intimate conversations: Groq first; Gemini is deliberately excluded.
# NEVER add a paid API key or enable billing. No provider below should be configured with paid models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional free-tier RP fallback; 20,000 tokens/day on the default account tier.
AION_API_KEY=
AION_MODEL=aion-labs/aion-rp-llama-3.1-8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Leave blank unless you have verified a free model/provider whose terms permit the intended mature conversation.
OPENROUTER_MATURE_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Trial tier only; not a high-volume provider.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Experimental/testing fallback only; 100K tokens/day free-token allowance, subject to change.
LLM7_API_KEY=
LLM7_MODEL=default
# Legacy Groq variables remain supported:
MODEL_API_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# Comma-separated exact frontend origins. Add your HTTPS app origin after hosting.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYLUS_OWNER_PASSWORD=replace-with-a-unique-private-password
SESSION_SECRET=replace-with-a-separate-random-64-character-secret
SESSION_TTL_SECONDS=1209600

# Optional private image generation and upload storage (Cloudflare Workers AI).
# Free Workers AI allocation is 10,000 Neurons/day; usage stops at the limit on Free.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional read-aloud voice. Use an original designed voice, not a clone of an actor.
# Only the selected assistant message text is sent to ElevenLabs when Read aloud is pressed.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
