# Copy this file to .env in the repository root. Never commit your real .env.

# Use independent random values; do not reuse any other credential.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
SYLUS_OWNER_TOKEN=replace-with-a-long-random-api-bootstrap-token
SYLUS_OWNER_PASSWORD=replace-with-a-unique-owner-password
SESSION_SECRET=replace-with-a-separate-random-64-character-secret
SESSION_TTL_SECONDS=1209600

# Local Docker Compose defaults. For HTTPS hosting, set APP_ENV=production.
APP_ENV=development
SYLUS_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Optional until you create a provider key. No paid fallback is configured.
MODEL_API_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
MODEL_NAME=openai/gpt-oss-120b
